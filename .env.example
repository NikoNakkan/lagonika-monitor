# Only used when running locally. On GitHub, set these as repository secrets instead.
# Gmail: use an App Password (Google Account -> Security -> 2-Step Verification -> App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
NOTIFY_EMAIL=kintokanndev@gmail.com

# Optional: comma-separated words; only deals whose title contains one get emailed. Empty = all.
KEYWORDS=
